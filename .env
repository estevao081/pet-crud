# Utilização do .env apenas por boa prática afinal todos sabemos que não se deve commitar este arquivo rs

POSTGRES_USER=meuuser
POSTGRES_PASSWORD=minhasenha

# Um banco por microserviço (criados por db/init-databases.sh)
USER_DB=user_db
PET_DB=pet_db

# Segredo do JWT: assinado pelo auth-service e verificado pelo gateway (precisa ser o mesmo valor nos dois)
SECRET_KEY=mykey
